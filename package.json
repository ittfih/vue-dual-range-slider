{
  "name": "vue-dual-range-slider",
  "private": false,
  "version": "1.0.3",
  "description": "Dual range slider",
  "main": "./dist/vue-dual-range-slider.umd.cjs",
  "module": "./dist/vue-dual-range-slider.js",
  "types": "./dist/index.d.ts",
  "author": "ittfih",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ittfih/vue-dual-range-slider"
  },
